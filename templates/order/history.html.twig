{% extends 'base.html.twig' %}
{% block title %}Mes commandes - SymPet{% endblock %}

{% block body %}
<div class="sp-page-header">
    <div class="container">
        <h1><i class="bi bi-clock-history me-2"></i>Mes Commandes</h1>
        <p>Retrouvez l'historique de toutes vos commandes</p>
    </div>
</div>

<div class="container py-5">
    {% if orders is empty %}
        <div class="text-center py-5">
            <div style="font-size:5rem;margin-bottom:1rem;">📦</div>
            <h3 style="font-weight:900;color:#1a2332;margin-bottom:0.5rem;">Aucune commande pour le moment</h3>
            <p class="text-muted mb-4">Commencez par explorer notre catalogue de produits !</p>
            <a href="{{ path('product_index') }}" class="btn btn-primary btn-lg">
                <i class="bi bi-bag me-2"></i>Découvrir nos produits
            </a>
        </div>
    {% else %}
        <div style="display:flex;flex-direction:column;gap:1rem;">
            {% for order in orders %}
            <a href="{{ path('order_show', {id: order.id}) }}" style="text-decoration:none;">
                <div class="sp-card" style="padding:1.4rem 1.8rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
                    <div style="background:#e8f5ee;border-radius:12px;width:52px;height:52px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">📦</div>
                    <div style="flex:1;min-width:200px;">
                        <div style="font-weight:900;color:#1a2332;font-size:1rem;">Commande #{{ order.id }}</div>
                        <div style="font-size:0.83rem;color:#6b7280;font-weight:600;margin-top:0.2rem;">
                            <i class="bi bi-calendar3 me-1"></i>{{ order.dateCommande|date('d/m/Y à H:i') }}
                        </div>
                    </div>
                    <div>
                        <span class="status-pill status-{{ order.statut.value|replace({' ': '_'})|lower }}">
                            {{ order.statut.value }}
                        </span>
                    </div>
                    <div style="font-weight:900;color:#2d8a4e;font-size:1.2rem;text-align:right;min-width:100px;">
                        {{ order.total|number_format(2, ',', ' ') }} DT
                    </div>
                    <div style="color:#9ca3af;font-size:1rem;">
                        <i class="bi bi-chevron-right"></i>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
