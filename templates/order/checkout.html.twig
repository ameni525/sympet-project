{% extends 'base.html.twig' %}
{% block title %}Validation de commande - SymPet{% endblock %}

{% block body %}
<div class="sp-page-header">
    <div class="container">
        <h1><i class="bi bi-credit-card me-2"></i>Validation de la commande</h1>
        <p>Plus qu'une étape avant de recevoir vos produits !</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="sp-card" style="padding:2rem;">
                <h5 style="font-weight:900;color:#1a2332;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                    <span style="background:#e8f5ee;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:0.9rem;font-weight:900;color:#2d8a4e;">1</span>
                    Adresse de livraison
                </h5>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Adresse complète</label>
                        <textarea name="address" class="form-control" rows="3"
                                  placeholder="12 Rue des Palmiers, Tunis 1000, Tunisie"
                                  required style="resize:none;"></textarea>
                        <div style="font-size:0.8rem;color:#9ca3af;margin-top:0.4rem;">
                            <i class="bi bi-info-circle me-1"></i>Veuillez indiquer votre adresse complète avec le code postal.
                        </div>
                    </div>

                    <h5 style="font-weight:900;color:#1a2332;margin-bottom:1.2rem;margin-top:2rem;display:flex;align-items:center;gap:0.5rem;">
                        <span style="background:#e8f5ee;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:0.9rem;font-weight:900;color:#2d8a4e;">2</span>
                        Mode de paiement
                    </h5>

                    <div style="background:#f0fdf4;border-radius:14px;padding:1.5rem;border:2px solid #c3e6ce;display:flex;align-items:center;gap:1rem;margin-bottom:1rem;">
                        <div style="width:48px;height:48px;background:white;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.08);">💳</div>
                        <div>
                            <div style="font-weight:800;color:#1a2332;font-size:0.95rem;">Carte bancaire via Stripe</div>
                            <div style="font-size:0.82rem;color:#6b7280;margin-top:0.2rem;">Paiement 100% sécurisé — Visa, Mastercard, etc.</div>
                        </div>
                        <div style="margin-left:auto;">
                            <i class="bi bi-shield-check" style="color:#2d8a4e;font-size:1.3rem;"></i>
                        </div>
                    </div>

                    <div style="background:#fffbeb;border-radius:12px;padding:1rem 1.2rem;border:1px solid #fde68a;margin-bottom:1.8rem;font-size:0.85rem;color:#92400e;font-weight:600;">
                        <i class="bi bi-info-circle-fill me-2" style="color:#f59e0b;"></i>
                        Vous serez redirigé vers Stripe pour finaliser le paiement en toute sécurité.
                    </div>

                    <button class="btn btn-primary w-100 py-3" type="submit" style="font-size:1.05rem;border-radius:14px;">
                        <i class="bi bi-lock-fill me-2"></i>Confirmer et payer — {{ total|number_format(2, ',', ' ') }} DT
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="sp-card" style="position:sticky;top:80px;padding:1.5rem;">
                <h5 style="font-weight:900;color:#1a2332;margin-bottom:1.2rem;padding-bottom:0.8rem;border-bottom:1px solid #e2ece2;">
                    🛒 Résumé de votre commande
                </h5>
                {% for item in items %}
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.8rem;padding-bottom:0.8rem;{% if not loop.last %}border-bottom:1px solid #f0f4f0;{% endif %}">
                    <div style="display:flex;align-items:center;gap:0.8rem;">
                        <div style="background:#e8f5ee;border-radius:8px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;font-weight:900;color:#2d8a4e;font-size:0.85rem;flex-shrink:0;">×{{ item.quantity }}</div>
                        <span style="font-size:0.88rem;font-weight:600;color:#374151;">{{ item.product.nom|capitalize|slice(0,25) }}{% if item.product.nom|length > 25 %}…{% endif %}</span>
                    </div>
                    <span style="font-weight:800;color:#1a2332;font-size:0.9rem;white-space:nowrap;margin-left:0.5rem;">{{ item.line_total|number_format(2, ',', ' ') }} DT</span>
                </div>
                {% endfor %}
                <div style="border-top:2px solid #e2ece2;padding-top:1rem;margin-top:0.5rem;display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-weight:900;color:#1a2332;font-size:1rem;">Total à payer</span>
                    <span style="font-weight:900;color:#2d8a4e;font-size:1.5rem;">{{ total|number_format(2, ',', ' ') }} DT</span>
                </div>
                <div style="background:#f9fafb;border-radius:12px;padding:1rem;margin-top:1rem;font-size:0.8rem;color:#6b7280;font-weight:600;">
                    <div class="d-flex gap-3 justify-content-center">
                        <span><i class="bi bi-shield-check me-1" style="color:#2d8a4e;"></i>Sécurisé</span>
                        <span><i class="bi bi-truck me-1" style="color:#2d8a4e;"></i>Livraison rapide</span>
                        <span><i class="bi bi-receipt me-1" style="color:#2d8a4e;"></i>Confirmation email</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
