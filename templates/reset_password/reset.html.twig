{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - SymPet{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg" style="width: 100%; max-width: 400px;">
        <div class="card-header bg-info text-white text-center">
            <h3 class="mb-0">🔄 Changer mon mot de passe</h3>
        </div>
        <div class="card-body">
            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword, {'attr': {'class': 'form-control mb-2'}}) }}
                <button type="submit" class="btn btn-info w-100 py-2 mt-3">Enregistrer</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
</div>
{% endblock %}
