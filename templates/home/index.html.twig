{% extends 'base.html.twig' %}
{% block title %}Accueil - SymPet{% endblock %}

{% block body %}

{# ─── HERO ─── #}
<section style="background:linear-gradient(135deg,#1e6b3b 0%,#2d8a4e 55%,#3aaa64 100%); color:white; padding:5rem 0 4rem; position:relative; overflow:hidden;">
    <div style="position:absolute;top:0;left:0;right:0;bottom:0;background-image:radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255,255,255,0.05) 0%, transparent 40%);pointer-events:none;"></div>
    <div style="position:absolute;right:-60px;bottom:-40px;font-size:280px;opacity:0.06;line-height:1;pointer-events:none;">🐾</div>
    <div style="position:absolute;left:-30px;top:-20px;font-size:180px;opacity:0.04;line-height:1;pointer-events:none;">🐕</div>
    <div class="container text-center" style="position:relative;z-index:2;">
        <div style="display:inline-block;background:rgba(255,255,255,0.12);border-radius:30px;padding:0.4rem 1.2rem;font-size:0.85rem;font-weight:700;margin-bottom:1.2rem;letter-spacing:0.06em;">
            🐾 BIENVENUE SUR SYMPET
        </div>
        <h1 style="font-family:'Pacifico',cursive;font-size:clamp(2rem,5vw,3.5rem);margin-bottom:1rem;line-height:1.2;">
            Tout pour le bonheur<br>de vos animaux 🐕🐈
        </h1>
        <p style="font-size:1.15rem;opacity:0.88;max-width:520px;margin:0 auto 2.2rem;font-weight:500;">
            Nourriture premium, accessoires tendance et produits de soin pour chiens, chats et tous vos compagnons.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="{{ path('product_index') }}" style="background:white;color:#1e6b3b;border-radius:14px;font-weight:900;padding:0.85rem 2rem;font-size:1rem;text-decoration:none;transition:all 0.25s;display:inline-flex;align-items:center;gap:0.5rem;box-shadow:0 6px 24px rgba(0,0,0,0.15);">
                🛍️ Découvrir la boutique
            </a>
            {% if not app.user %}
            <a href="{{ path('app_register') }}" style="background:rgba(255,255,255,0.15);color:white;border:2px solid rgba(255,255,255,0.4);border-radius:14px;font-weight:800;padding:0.85rem 1.8rem;font-size:1rem;text-decoration:none;transition:all 0.25s;display:inline-flex;align-items:center;gap:0.5rem;">
                👤 Créer un compte
            </a>
            {% endif %}
        </div>
        <div class="mt-4 d-flex gap-4 justify-content-center flex-wrap" style="opacity:0.75;font-size:0.9rem;font-weight:600;">
            <span>✅ Livraison rapide</span>
            <span>🔒 Paiement sécurisé</span>
            <span>⭐ Produits premium</span>
        </div>
    </div>
</section>

{# ─── ANIMAL CATEGORIES ─── #}
<section class="container py-5">
    <div class="text-center mb-4">
        <span class="sp-section-title">Nos amis à 4 pattes</span>
        <p class="text-muted mt-3 mb-0">Tout ce dont ils ont besoin, rien que pour eux</p>
    </div>
    <div class="row g-3 justify-content-center">
        <div class="col-6 col-md-3">
            <a href="{{ path('product_index') }}" style="text-decoration:none;">
                <div class="sp-card text-center p-4" style="cursor:pointer;">
                    <div style="font-size:3.5rem;margin-bottom:0.5rem;">🐕</div>
                    <div style="font-weight:800;color:#1a2332;font-size:0.95rem;">Chiens</div>
                    <div style="font-size:0.78rem;color:#6b7280;margin-top:0.2rem;">Alimentation & Accessoires</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('product_index') }}" style="text-decoration:none;">
                <div class="sp-card text-center p-4" style="cursor:pointer;">
                    <div style="font-size:3.5rem;margin-bottom:0.5rem;">🐈</div>
                    <div style="font-weight:800;color:#1a2332;font-size:0.95rem;">Chats</div>
                    <div style="font-size:0.78rem;color:#6b7280;margin-top:0.2rem;">Nourriture & Jouets</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('product_index') }}" style="text-decoration:none;">
                <div class="sp-card text-center p-4" style="cursor:pointer;">
                    <div style="font-size:3.5rem;margin-bottom:0.5rem;">🐦</div>
                    <div style="font-weight:800;color:#1a2332;font-size:0.95rem;">Oiseaux</div>
                    <div style="font-size:0.78rem;color:#6b7280;margin-top:0.2rem;">Graines & Cages</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="{{ path('product_index') }}" style="text-decoration:none;">
                <div class="sp-card text-center p-4" style="cursor:pointer;">
                    <div style="font-size:3.5rem;margin-bottom:0.5rem;">🐠</div>
                    <div style="font-weight:800;color:#1a2332;font-size:0.95rem;">Aquarium</div>
                    <div style="font-size:0.78rem;color:#6b7280;margin-top:0.2rem;">Poissons & Plantes</div>
                </div>
            </a>
        </div>
    </div>
</section>

{# ─── WHY US ─── #}
<section style="background:white;padding:4rem 0;">
    <div class="container">
        <div class="text-center mb-4">
            <span class="sp-section-title">Pourquoi choisir SymPet ?</span>
        </div>
        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div style="width:72px;height:72px;background:linear-gradient(135deg,#e8f5ee,#c3e6ce);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.2rem;">🚚</div>
                    <h5 style="font-weight:900;color:#1a2332;">Livraison Express</h5>
                    <p class="text-muted mb-0" style="font-size:0.92rem;">Préparation et expédition le jour même pour toutes les commandes passées avant 14h.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div style="width:72px;height:72px;background:linear-gradient(135deg,#fff3e8,#fed7aa);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.2rem;">🔒</div>
                    <h5 style="font-weight:900;color:#1a2332;">Paiement Sécurisé</h5>
                    <p class="text-muted mb-0" style="font-size:0.92rem;">Transactions sécurisées par Stripe. Vos données bancaires sont totalement protégées.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div style="width:72px;height:72px;background:linear-gradient(135deg,#eff6ff,#bfdbfe);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.2rem;">🏆</div>
                    <h5 style="font-weight:900;color:#1a2332;">Qualité Premium</h5>
                    <p class="text-muted mb-0" style="font-size:0.92rem;">Tous nos produits sont sélectionnés avec soin pour la santé et le bien-être de vos animaux.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ─── CTA ─── #}
<section class="container py-5">
    <div style="background:linear-gradient(135deg,#2d8a4e,#1e6b3b);border-radius:24px;padding:3rem 2rem;text-align:center;color:white;position:relative;overflow:hidden;">
        <div style="position:absolute;right:-20px;bottom:-20px;font-size:150px;opacity:0.07;pointer-events:none;">🐾</div>
        <h2 style="font-family:'Pacifico',cursive;font-size:1.8rem;margin-bottom:0.8rem;">Prêt à gâter vos animaux ?</h2>
        <p style="opacity:0.85;margin-bottom:1.8rem;font-size:1rem;font-weight:500;">Découvrez toute notre gamme de produits et faites plaisir à vos compagnons.</p>
        <a href="{{ path('product_index') }}" style="background:white;color:#1e6b3b;border-radius:14px;font-weight:900;padding:0.85rem 2.2rem;font-size:1rem;text-decoration:none;display:inline-block;">
            🛍️ Voir tous les produits →
        </a>
    </div>
</section>

{% endblock %}
