<h2>Merci pour votre commande #{{ order.id }}</h2>
<p>Votre commande est confirmée et en cours de traitement.</p>
<p><strong>Adresse de livraison:</strong> {{ order.adresseLivraison }}</p>
<table style="width:100%;border-collapse:collapse;">
    <thead>
    <tr><th style="text-align:left;border-bottom:1px solid #ddd;">Produit</th><th style="text-align:left;border-bottom:1px solid #ddd;">Qté</th><th style="text-align:left;border-bottom:1px solid #ddd;">Sous-total</th></tr>
    </thead>
    <tbody>
    {% for line in order.ligneCommandes %}
        <tr>
            <td>{{ line.produit.nom }}</td>
            <td>{{ line.quantite }}</td>
            <td>{{ line.sousTotale|number_format(2, ',', ' ') }} DT</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
<p><strong>Total:</strong> {{ order.total|number_format(2, ',', ' ') }} DT</p>
