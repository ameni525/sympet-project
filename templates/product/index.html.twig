{% extends 'base.html.twig' %}
{% block title %}Nos Produits - SymPet{% endblock %}

{% block body %}

<div class="sp-page-header">
    <div class="container">
        <h1><i class="bi bi-grid-3x3-gap me-2"></i>Nos Produits</h1>
        <p>Trouvez le bonheur de votre animal parmi nos produits sélectionnés avec soin</p>
    </div>
</div>

<div class="container py-4">

    {# ─── SEARCH BAR ─── #}
    <div class="sp-card p-4 mb-4">
        <form method="GET" action="{{ path('product_search') }}">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label"><i class="bi bi-search me-1 text-green"></i>Rechercher un produit</label>
                    <input type="text" name="name" class="form-control" placeholder="Ex: croquettes, collier, jouet…" value="{{ app.request.query.get('name') }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-tag me-1 text-green"></i>Catégorie</label>
                    <select name="category" class="form-select">
                        <option value="">Toutes les catégories</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}" {{ app.request.query.get('category') == cat.id ? 'selected' : '' }}>{{ cat.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Chercher</button>
                </div>
                <div class="col-md-1">
                    <a href="{{ path('product_index') }}" class="btn btn-outline-secondary w-100" title="Réinitialiser"><i class="bi bi-x-lg"></i></a>
                </div>
            </div>
        </form>
    </div>

    {# ─── PRODUCT GRID ─── #}
    <div class="row g-4">
        {% for product in products %}
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="sp-card h-100" style="display:flex;flex-direction:column;">
                    <div style="position:relative;overflow:hidden;">
                        <img src="{{ product.image }}"
                             style="width:100%;height:210px;object-fit:cover;transition:transform 0.4s ease;"
                             alt="{{ product.nom }}"
                             onmouseover="this.style.transform='scale(1.05)'"
                             onmouseout="this.style.transform='scale(1)'">
                        <div style="position:absolute;top:10px;left:10px;">
                            <span class="sp-badge-cat">{{ product.categorie.nom }}</span>
                        </div>
                        {% if product.stock == 0 %}
                        <div style="position:absolute;top:10px;right:10px;">
                            <span class="sp-badge-out">Rupture</span>
                        </div>
                        {% endif %}
                    </div>
                    <div style="padding:1.2rem;display:flex;flex-direction:column;flex:1;">
                        <h5 style="font-weight:800;font-size:1rem;color:#1a2332;margin-bottom:0.4rem;line-height:1.3;">{{ product.nom|capitalize }}</h5>
                        <p style="font-size:0.83rem;color:#6b7280;margin-bottom:auto;line-height:1.5;">{{ product.description|slice(0,75) }}…</p>
                        <div style="margin-top:1rem;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.9rem;">
                                <span class="sp-price">{{ product.prix }} DT</span>
                                {% if product.stock > 0 %}
                                    <span style="font-size:0.78rem;color:#6b7280;font-weight:600;">
                                        <i class="bi bi-box-seam me-1" style="color:#2d8a4e;"></i>{{ product.stock }} en stock
                                    </span>
                                {% endif %}
                            </div>
                            <a href="{{ path('product_show', {id: product.id}) }}"
                               style="display:block;text-align:center;background:linear-gradient(135deg,#2d8a4e,#1e6b3b);color:white;border-radius:12px;padding:0.6rem 1rem;font-weight:800;text-decoration:none;font-size:0.9rem;transition:all 0.25s;"
                               onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 18px rgba(45,138,78,0.35)'"
                               onmouseout="this.style.transform='';this.style.boxShadow=''">
                                Voir le produit →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div style="font-size:5rem;margin-bottom:1rem;">🐾</div>
                <h4 style="font-weight:800;color:#1a2332;">Aucun produit trouvé</h4>
                <p class="text-muted">Essayez avec d'autres mots-clés ou une autre catégorie.</p>
                <a href="{{ path('product_index') }}" class="btn btn-primary mt-2">Voir tous les produits</a>
            </div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-5 mb-3">
        {{ knp_pagination_render(products) }}
    </div>
</div>

{% endblock %}
