<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin - SymPet{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background:#f5f4ef; }
        .admin-shell { max-width: 1180px; margin: 0 auto; }
        .admin-card { background:white;border-radius:18px;border:1px solid #e2ece2;box-shadow:0 4px 16px rgba(45,138,78,.08); }
        .admin-title { font-weight:900;color:#1a2332; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg" style="background:#1a2332;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="{{ path('produit_index') }}">SymPet Admin 🐾</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="adminNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('produit_index') }}"><i class="bi bi-box-seam me-1"></i>Produits</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-tags me-1"></i>Catégories</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#"><i class="bi bi-receipt me-1"></i>Commandes</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                <li class="nav-item">
                    <a class="btn btn-success btn-sm" href="{{ path('produit_new') }}"><i class="bi bi-plus-lg me-1"></i>Nouveau produit</a>
                </li>
                <li class="nav-item">
                    <a class="btn btn-outline-light btn-sm" href="{{ path('product_index') }}" target="_blank"><i class="bi bi-shop me-1"></i>Voir la boutique</a>
                </li>
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>{{ app.user.userIdentifier|split('@')|first }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show rounded-0 mb-0">
            <div class="container-fluid">{{ message }}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="container-fluid py-4 admin-shell">
    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
