{% extends 'produit/base_admin.html.twig' %}

{% block title %}Gestion Produits - Admin SymPet{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>Produits</h2>
    <a href="{{ path('produit_new') }}" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Nouveau produit</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Catégorie</th>
                    <th>Prix</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for produit in products %}
                    <tr>
                        <td>
                            <img src="{{ produit.image }}" style="width:50px; height:50px; object-fit:cover;" class="rounded" alt="{{ produit.nom }}">
                        </td>
                        <td class="fw-semibold">{{ produit.nom|capitalize }}</td>
                        <td><span class="badge bg-primary">{{ produit.categorie.nom }}</span></td>
                        <td class="fw-bold text-primary">{{ produit.prix }} DT</td>
                        <td>
                            {% if produit.stock == 0 %}
                                <span class="badge bg-danger">Rupture</span>
                            {% elseif produit.stock < 5 %}
                                <span class="badge bg-warning text-dark">{{ produit.stock }}</span>
                            {% else %}
                                <span class="badge bg-success">{{ produit.stock }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('produit_show', {'id': produit.id}) }}" class="btn btn-warning"><i class="bi bi-eye"></i></a>
                                <a href="{{ path('produit_edit', {'id': produit.id}) }}" class="btn btn-primary"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="{{ path('produit_delete', {'id': produit.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce produit ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Aucun produit. <a href="{{ path('produit_new') }}">Créer le premier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
