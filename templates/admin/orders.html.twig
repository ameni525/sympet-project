{% extends 'produit/base_admin.html.twig' %}

{% block title %}Commandes - Admin SymPet{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="admin-title mb-0"><i class="bi bi-receipt me-2"></i>Gestion des commandes</h2>
    <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">Retour dashboard</a>
</div>

<div class="admin-card p-3">
    <div class="d-flex justify-content-between align-items-center px-2 pb-2">
        <h6 class="mb-0 fw-bold text-secondary text-uppercase" style="letter-spacing:.06em;">Historique global</h6>
        <span class="badge text-bg-light border">{{ orders|length }} commandes</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Client</th>
                    <th>Email</th>
                    <th>Statut</th>
                    <th>Total</th>
                    <th>Détail</th>
                </tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr>
                    <td><span class="badge text-bg-light border">#{{ order.id }}</span></td>
                    <td>{{ order.dateCommande|date('d/m/Y H:i') }}</td>
                    <td class="fw-semibold">{{ order.user.prenom }} {{ order.user.nom }}</td>
                    <td>{{ order.user.email }}</td>
                    <td><span class="badge bg-info text-dark">{{ order.statut.value }}</span></td>
                    <td class="fw-bold">{{ order.total|number_format(2, ',', ' ') }} DT</td>
                    <td><a href="{{ path('admin_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucune commande.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
