{% extends 'produit/base_admin.html.twig' %}

{% block title %}Commande #{{ order.id }} - Admin{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="admin-title mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Commande #{{ order.id }}</h2>
    <a href="{{ path('admin_orders') }}" class="btn btn-outline-secondary">Retour commandes</a>
</div>

<div class="admin-card p-4 mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Client:</strong> {{ order.user.prenom }} {{ order.user.nom }} ({{ order.user.email }})</p>
        <p class="mb-1"><strong>Date:</strong> {{ order.dateCommande|date('d/m/Y H:i') }}</p>
        <p class="mb-1"><strong>Statut:</strong> {{ order.statut.value }}</p>
        <p class="mb-0"><strong>Adresse:</strong> {{ order.adresseLivraison ?: '-' }}</p>
    </div>
</div>

<div class="admin-card p-3">
    <div class="card-body p-0">
        <table class="table mb-0 align-middle">
            <thead class="table-dark">
                <tr><th>Produit</th><th>Qté</th><th>PU</th><th>Sous-total</th></tr>
            </thead>
            <tbody>
            {% for line in order.ligneCommandes %}
                <tr>
                    <td>{{ line.produit.nom }}</td>
                    <td>{{ line.quantite }}</td>
                    <td>{{ line.prixUnitaire|number_format(2, ',', ' ') }} DT</td>
                    <td>{{ line.sousTotale|number_format(2, ',', ' ') }} DT</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-footer text-end fw-bold">Total: {{ order.total|number_format(2, ',', ' ') }} DT</div>
</div>
{% endblock %}
