{% extends 'produit/base_admin.html.twig' %}

{% block title %}Clients - Admin SymPet{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="admin-title mb-0"><i class="bi bi-people me-2"></i>Gestion des clients</h2>
    <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">Retour dashboard</a>
</div>

<div class="admin-card p-3">
    <div class="d-flex justify-content-between align-items-center px-2 pb-2">
        <h6 class="mb-0 fw-bold text-secondary text-uppercase" style="letter-spacing:.06em;">Liste des clients</h6>
        <span class="badge text-bg-light border">{{ users|length }} clients</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nom complet</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Vérifié</th>
                    <th>Inscription</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td><span class="badge text-bg-light border">#{{ user.id }}</span></td>
                    <td class="fw-semibold">{{ user.prenom }} {{ user.nom }}</td>
                    <td>{{ user.email }}</td>
                    <td><code class="small">{{ user.roles|join(', ') }}</code></td>
                    <td>
                        {% if user.isVerified %}
                            <span class="badge bg-success">Oui</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">Non</span>
                        {% endif %}
                    </td>
                    <td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '-' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Aucun client.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
